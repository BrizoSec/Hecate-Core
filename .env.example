# -----------------------------------------------------------------------------
# ATHF workspace configuration
#
# Copy this file to .env and edit for your environment.
#
# This file owns everything the `athf` CLI itself reads: the LLM, web search
# and Splunk. athf loads this file from the workspace directory on every run,
# so these settings apply to manual `athf ...` invocations and to hunts driven
# by hecate-runner alike.
#
# Runner-side settings (CTI polling, draft quotas, schedules — every
# HECATE_RUNNER_* name) live in Hecate-Runner/.env instead. Nothing is meant to
# appear in both files; if a variable is here, this is the only place to set it.
# -----------------------------------------------------------------------------

# --- LLM provider -------------------------------------------------------------
# Credentials. Setting any one of these is enough — athf autodetects the
# provider from whichever is present, in this order.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# AWS_PROFILE=default            # or AWS_ACCESS_KEY_ID, selects Bedrock
#
# Gemini is NOT autodetected. It reaches the model through litellm, so it
# needs an explicit model below (ATHF_LLM_PROVIDER=litellm,
# ATHF_LLM_MODEL=gemini/gemini-1.5-pro) as well as the key.
# GOOGLE_API_KEY=...

# Ollama endpoint. macOS: native Ollama with Metal GPU (recommended).
# OLLAMA_HOST=http://host.docker.internal:11434
# Docker: use --profile ollama instead.
# OLLAMA_HOST=http://ollama:11434

# Explicit provider/model overrides. Without them athf autodetects from
# whichever credentials above are present.
# ATHF_LLM_PROVIDER=ollama
# ATHF_LLM_MODEL=qwen2.5:14b-instruct-q4_K_M

# Per-request Ollama timeout in seconds (default 180). Raise it for a large
# (10B+) local model — 180s is tight on GPU-constrained hosts, and a timeout
# here surfaces as a failed hunt draft rather than an obvious error.
# ATHF_OLLAMA_TIMEOUT_SEC=600

# --- Web search ---------------------------------------------------------------
# Used by the research agent's adversary-tradecraft skill. Without it,
# `athf research new` still runs but skips the web-search step, which is what
# grounds a hunt in real reporting rather than model recall. Free tier at
# https://tavily.com
# TAVILY_API_KEY=tvly-...

# --- Splunk -------------------------------------------------------------------
# Read by `athf splunk search` (and so by hecate-runner when its query provider
# is set to splunk). Leave commented until real access exists.
# SPLUNK_HOST=your-splunk-host
# SPLUNK_TOKEN=your-splunk-token-here
# Set false only for a self-signed dev instance (default true).
# SPLUNK_VERIFY_SSL=true
